# ST Atlas configuration. Copy to `.env` only if you need to change something;
# `docker compose up -d` works without it. Never commit `.env`.

# Where the web UI listens. Keep 127.0.0.1 unless you put HTTPS in front (docs/deployment/INSTALLATION.md).
ATLAS_BIND_ADDRESS=127.0.0.1
ATLAS_PORT=8080

# Set to true when users reach ST Atlas over HTTPS (adds the Secure flag to cookies).
ATLAS_SECURE_COOKIES=false

# Maximum upload size (images, PDFs).
ATLAS_MAX_UPLOAD_SIZE=25MB

# Idle session timeout (absolute lifetime is 12h).
ATLAS_SESSION_IDLE_TIMEOUT=2h

# OpenAPI/Swagger UI for administrators only. Off by default.
ATLAS_API_DOCS_ENABLED=false
